<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <!--
    Пример Aspire-хоста: тот же набор свойств и пакетов, что и в обычном проекте AppHost.
    Нужен, чтобы проверять расширение на проектах Aspire — там отладка идёт через тип «aspire».
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAspireHost>true</IsAspireHost>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Dashboard.Sdk.linux-x64" Version="13.6.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspireApp.Api\AspireApp.Api.csproj" />
  </ItemGroup>

</Project>
