<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Тесты моста: проверяют разбор данных и реальный сбор метрик с демонстрационного приложения.
    xUnit v3 работает через Microsoft.Testing.Platform (см. global.json), поэтому `dotnet test`
    умеет таймауты прогона, лимит падений и каталог результатов.
  -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ссылка нужна и для тестов внутренних классов, и для запуска моста в e2e-тесте. -->
    <ProjectReference Include="..\MonitorDotnet.Bridge\MonitorDotnet.Bridge.csproj" />
    <!-- Образец собирается вместе с тестами; его сборку использует e2e-тест. -->
    <ProjectReference Include="..\..\samples\SampleApp\SampleApp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
