{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Запустить расширение",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "собрать расширение"
    },
    {
      "name": "Запустить расширение и приложение-образец",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/samples/SampleApp"],
      "outFiles": ["${workspaceFolder}/dist/**/*.cjs"],
      "preLaunchTask": "собрать расширение"
    }
  ]
}
